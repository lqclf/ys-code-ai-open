<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <artifactId>ys-boot-template</artifactId>
        <groupId>com.eric</groupId>
        <version>1.0.0</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <artifactId>ys-infra</artifactId>
    <packaging>pom</packaging>

    <description>
        基础设施层 - 与具体业务无关的通用技术能力聚合模块
        功能：日志采集、后续可扩展缓存、消息、文件存储等基础设施能力
    </description>

    <modules>
        <!-- 系统日志模块：登录日志、操作日志、异常日志的采集与查询 -->
        <module>ys-infra-log</module>
        <!-- 字典模块：字典类型与字典项维护 -->
        <module>ys-infra-dict</module>
        <!-- 枚举模块：枚举值下发 -->
        <module>ys-infra-enum</module>
        <!-- 文件上传模块（简化版）：本地/MinIO 存储、单文件/批量上传、下载、物理删除 -->
        <module>ys-infra-file</module>
    </modules>

</project>
