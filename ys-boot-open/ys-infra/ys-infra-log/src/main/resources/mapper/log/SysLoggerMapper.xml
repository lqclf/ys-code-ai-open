<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.eric.log.module.mapper.SysLoggerMapper">

    <!-- 系统日志基础结果映射 -->
    <resultMap id="BaseResultMap" type="com.eric.log.module.entity.SysLogger">
        <id column="id" property="id"/>
        <result column="log_type" property="logType"/>
        <result column="modul" property="modul"/>
        <result column="type" property="type"/>
        <result column="remark" property="remark"/>
        <result column="req_param" property="reqParam"/>
        <result column="resp_param" property="respParam"/>
        <result column="user_id" property="userId"/>
        <result column="login_name" property="loginName"/>
        <result column="user_name" property="userName"/>
        <result column="method" property="method"/>
        <result column="url" property="url"/>
        <result column="ip" property="ip"/>
        <result column="address" property="address"/>
        <result column="win" property="win"/>
        <result column="user_agent" property="userAgent"/>
        <result column="version" property="version"/>
        <result column="log_time" property="logTime"/>
        <result column="exc_name" property="excName"/>
        <result column="exc_msg" property="excMsg"/>
        <result column="trace_id" property="traceId"/>
        <result column="log_level" property="logLevel"/>
    </resultMap>

    <!-- 通用查询列 -->
    <sql id="Base_Column_List">
        id, log_type, modul, type, remark, req_param, resp_param, user_id, login_name, user_name,
        method, url, ip, address, win, user_agent, version, log_time, exc_name, exc_msg, trace_id, log_level
    </sql>
</mapper>
